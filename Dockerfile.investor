# ============================================================
# MEVREON BIO-AI PLATFORM — Investor Demo Dockerfile
# Multi-stage build: Node.js builds React → nginx:alpine serves it
# ============================================================
# This Dockerfile is purpose-built for the investor demo.
# It produces a ~30MB container that serves the React SPA
# with all pre-computed Ayush compound docking data baked in.
# No backend compute, no GPU, no Python — just static files.
# ============================================================

# ── Stage 1: Build the React Frontend ──
FROM node:20-alpine AS builder

WORKDIR /build

# Copy package manifests first (cache layer optimization)
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies
RUN npm ci --no-audit --no-fund

# Copy frontend source code
COPY frontend/src ./src
COPY frontend/index.html ./index.html
COPY frontend/vite.config.ts ./vite.config.ts
COPY frontend/tsconfig.json ./tsconfig.json
COPY frontend/postcss.config.js ./postcss.config.js
COPY frontend/tailwind.config.js ./tailwind.config.js

# Copy pre-computed docking data into public/ so Vite bundles it
COPY frontend/public ./public

# Build the production bundle
RUN npm run build


# ── Stage 2: Production Runtime (nginx:alpine ~25MB) ──
FROM nginx:1.27-alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our custom nginx config (SPA routing + gzip + Cloud Run PORT)
COPY nginx.conf /etc/nginx/templates/default.conf.template

# Copy the built React app from Stage 1
COPY --from=builder /build/dist /usr/share/nginx/html

# Cloud Run requires the container to listen on $PORT (default 8080)
ENV PORT=8080

# Healthcheck — Cloud Run also probes this
HEALTHCHECK --interval=30s --timeout=5s --start-period=3s --retries=2 \
    CMD wget -qO- http://localhost:${PORT}/ || exit 1

EXPOSE 8080

# nginx:alpine with envsubst template support starts automatically
# The default entrypoint processes /etc/nginx/templates/*.template files,
# substituting environment variables (like $PORT), then starts nginx.
CMD ["nginx", "-g", "daemon off;"]
