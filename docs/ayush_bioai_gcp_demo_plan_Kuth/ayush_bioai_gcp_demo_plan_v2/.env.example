# AYUSH Bio-AI Evidence Demo — environment template (placeholders only; no real values).
# Copy to .env (git-ignored) and fill in. See docs/13_ENV_VAR_CONFIG_CONTRACT.md.
# Bucket names use the derived gs://${PROJECT_ID}-ayush-bioai-* convention.

# Pipeline mode: local-planning | mock | real-data-fetch | real-docking | gcp-deployment | demo
RUN_MODE=mock

# GCP identifiers (no literals committed)
PROJECT_ID=<your-gcp-project-id>
REGION=<region>
ZONE=<region>-<zoneletter>
SERVICE_ACCOUNT=<sa-name>@<your-gcp-project-id>.iam.gserviceaccount.com

# Derived buckets
INPUTS_BUCKET=gs://${PROJECT_ID}-ayush-bioai-inputs
OUTPUTS_BUCKET=gs://${PROJECT_ID}-ayush-bioai-outputs
MODEL_CACHE_BUCKET=gs://${PROJECT_ID}-ayush-bioai-model-cache

# Artifact Registry / images
ARTIFACT_REPO=ayush-bioai
IMAGE_TAG=latest

# Service wiring
API_BASE_URL=https://<api-host>

# Vertex AI (Gemini Evidence Passport); falls back to local mock if unavailable
VERTEX_LOCATION=<vertex-region>
VERTEX_MODEL_ID=<gemini-model-id>
GOOGLE_CLOUD_PROJECT=<your-gcp-project-id>

# GPU VM (Option B — scripted Compute Engine VM; defaults shown). GPU quota must be granted in REGION.
VM_NAME=ayush-diffdock-gpu-vm
VM_MACHINE_TYPE=g2-standard-8          # L4 bundled; for T4 use n1-standard-8 + GPU_FLAGS below
GPU_FLAGS=                             # T4 example: --accelerator=type=nvidia-tesla-t4,count=1
BOOT_DISK_GB=200
VM_IMAGE_FAMILY=common-cu123
VM_IMAGE_PROJECT=deeplearning-platform-release

# Internal only; allowed solely when RUN_MODE=mock
# MOCK_MODE=true
